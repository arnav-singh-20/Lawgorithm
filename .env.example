# Copy to .env and fill in. NEVER commit .env or paste its values anywhere.
# `python -m scripts.deploy_space` sends the secret ones to the Hugging Face
# Space as private secrets.

# ── AI (Groq, free tier: https://console.groq.com/keys) ──
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_key_here
# Optional overrides (defaults shown). Each model has its own free daily
# allowance; when one runs out the next takes over.
# GROQ_MODEL_AGENT=openai/gpt-oss-120b
# GROQ_MODEL_AGENT_FALLBACKS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# GROQ_MODEL_LIGHT=qwen/qwen3.8-27b
# GROQ_MODEL_LIGHT_FALLBACKS=openai/gpt-oss-20b
# AGENT_MODE=prefetch            # or "react" (more searches, ~4x the tokens)

# ── Privacy (DPDP Act, 2023) ──
# STORE_ANALYSES=false           # true keeps analyses in the local database
# RESULT_TTL_MINUTES=60

# ── Human expert review (reviewer page: <site>/#/review) ──
# Owner key(s), "Name=key". Create with: python -m scripts.add_reviewer Your Name
REVIEWER_KEYS="Your Name=generated_by_add_reviewer"
# Fine-grained HF token: write access to ONLY the private review dataset
HF_REVIEW_TOKEN=hf_your_fine_grained_token
# team = "a member of the Lawgorithm team" checks clauses; legal = "a lawyer or law student"
# REVIEWER_KIND=team

# ── Payments (Razorpay: https://dashboard.razorpay.com -> API keys) ──
# Leave empty and everything is free. Test keys (rzp_test_...) work before KYC.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
# RAZORPAY_KEY_SECRET=your_key_secret
# PRICE_ANALYSIS_PAISE=1000      # Rs 10 per contract (samples are always free)
# EXPERT_REVIEW_PRICE_PAISE=0    # e.g. 500 = Rs 5, once a lawyer reviews

# ── Business details shown on Terms / Contact pages (Razorpay requires them) ──
# BUSINESS_NAME=Lawgorithm
# CONTACT_EMAIL=hello@yourdomain.in
