# Rename to .env and fill in real values

GEMINI_API_KEY=your_key_here

# Single source of truth for which model the agent/translator use.
# Keep this in sync with whatever's current in Gemini's docs -- don't
# hardcode a model name anywhere else in the codebase or in the README.
LAWGORITHM_MODEL=gemini-3.6-flash

# SQLite by default, swap for Postgres later if needed
DATABASE_URL=sqlite:///./lawgorithm.db

# Confidence-gating threshold for human verification (Phase 10)
CONFIDENCE_THRESHOLD=0.85

# Where the persistent vector DB is stored on disk
CHROMA_PERSIST_DIR=./chroma_db

# Embedding model (sentence-transformers). Change if you swap models later.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
